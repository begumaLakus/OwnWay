generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── KULLANICI ────────────────────────────────────────────
model User {
  id                 Int                      @id @default(autoincrement())
  email              String?                  @unique @db.VarChar(255)
  password_hash      String?
  role               String?                  @db.VarChar(50)

  profile            User_Profile?
  test_scores        User_Test_Score?
  career_suggestions User_Career_Suggestion[]
  matched_cities     User_Matched_City[]

  @@map("users")
}

model User_Profile {
  user_id          Int       @id
  first_name       String?   @db.VarChar(100)
  last_name        String?   @db.VarChar(100)
  current_location String?   @db.VarChar(100)
  high_school      String?   @db.VarChar(255)
  dept_type        String?   @db.VarChar(50)
  financial_status String?   @db.VarChar(50)
  personality_type String?   @db.VarChar(50)
  created_at       DateTime? @default(now()) @db.Timestamp(6)

  user             User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model User_Test_Score {
  user_id   Int      @id
  culture_w Decimal? @db.Decimal
  nature_w  Decimal? @db.Decimal
  social_w  Decimal? @db.Decimal
  modern_w  Decimal? @db.Decimal

  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_test_scores")
}

model User_Career_Suggestion {
  id              Int     @id @default(autoincrement())
  user_id         Int?
  occupation_name String? @db.VarChar(255)

  user            User?   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_career_suggestions")
}

model User_Matched_City {
  id          Int   @id @default(autoincrement())
  user_id     Int?
  city_id     Int?
  match_order Int?

  user        User? @relation(fields: [user_id], references: [id], onDelete: Cascade)
  city        City? @relation(fields: [city_id], references: [id], onDelete: Cascade)

  @@map("user_matched_cities")
}

// ─── ŞEHİR & ÜNİVERSİTE ─────────────────────────────────
model City {
  id                  Int                 @id @default(autoincrement())
  city_name           String?             @db.VarChar(100)
  total_student_count Int?
  culture_score       Decimal?            @db.Decimal
  nature_score        Decimal?            @db.Decimal
  social_score        Decimal?            @db.Decimal
  modern_score        Decimal?            @db.Decimal
  total_cost_index    Decimal?            @db.Decimal

  universities        University[]
  matched_users       User_Matched_City[]

  @@map("cities")
}

model University {
  id           Int          @id @default(autoincrement())
  city_id      Int?
  uni_name     String?      @db.VarChar(255)
  uni_type     String?      @db.VarChar(50)
  has_campus   Boolean?
  campus_count Int?

  city         City?        @relation(fields: [city_id], references: [id], onDelete: Cascade)
  departments  Department[]

  @@map("universities")
}

model Department {
  id                   Int         @id @default(autoincrement())
  uni_id               Int?
  dept_name            String?     @db.VarChar(255)
  base_rank            Int?
  base_score           Decimal?    @db.Decimal
  language             String?     @db.VarChar(50)
  quota                Int?
  female_student_count Int?
  male_student_count   Int?

  university           University? @relation(fields: [uni_id], references: [id], onDelete: Cascade)

  @@map("departments")
}